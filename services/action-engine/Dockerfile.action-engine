# syntax=docker/dockerfile:1
# Action-engine service image.
#
# Requires buildx with a pre-built builder image:
#   docker buildx build -t smart-cicd-builder:local . --push
#   docker buildx build \
#       --build-context smart-cicd-builder=docker-image://smart-cicd-builder:local \
#       -f services/action-engine/Dockerfile.action-engine \
#       -t ghcr.io/bolinz/smart-cicd/action-engine:$TAG .
#
# Simpler local build (no buildx required):
#   docker build --target runtime-action-engine -f Dockerfile -t smart-cicd/action-engine:local .

FROM gcr.io/distroless/nodejs20-debian11 AS runtime
WORKDIR /app
COPY --from=smart-cicd-builder /app/dist/services/action-engine/ ./services/action-engine/
COPY --from=smart-cicd-builder /app/package.json ./
COPY --from=smart-cicd-builder /app/node_modules ./node_modules
ENV NODE_ENV=production
CMD ["services/action-engine/index.js"]
