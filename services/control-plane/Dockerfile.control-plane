# syntax=docker/dockerfile:1
# Control-plane service image.
#
# Requires buildx with a pre-built builder image:
#   docker buildx build -t smart-cicd-builder:local . --push
#   docker buildx build \
#       --build-context smart-cicd-builder=docker-image://smart-cicd-builder:local \
#       -f services/control-plane/Dockerfile.control-plane \
#       -t ghcr.io/bolinz/smart-cicd/control-plane:$TAG .
#
# Simpler local build (no buildx required):
#   docker build --target runtime-control-plane -f Dockerfile -t smart-cicd/control-plane:local .

FROM gcr.io/distroless/nodejs20-debian11 AS runtime
WORKDIR /app
COPY --from=smart-cicd-builder /app/dist/services/control-plane/ ./services/control-plane/
COPY --from=smart-cicd-builder /app/package.json ./
COPY --from=smart-cicd-builder /app/node_modules ./node_modules
ENV NODE_ENV=production
CMD ["services/control-plane/index.js"]
