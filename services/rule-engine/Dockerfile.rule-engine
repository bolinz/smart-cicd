# syntax=docker/dockerfile:1
# Rule-engine service image.
#
# Requires buildx with a pre-built builder image:
#   docker buildx build -t smart-cicd-builder:local . --push
#   docker buildx build \
#       --build-context smart-cicd-builder=docker-image://smart-cicd-builder:local \
#       -f services/rule-engine/Dockerfile.rule-engine \
#       -t ghcr.io/bolinz/smart-cicd/rule-engine:$TAG .
#
# Simpler local build (no buildx required):
#   docker build --target runtime-rule-engine -f Dockerfile -t smart-cicd/rule-engine:local .

FROM gcr.io/distroless/nodejs20-debian11 AS runtime
WORKDIR /app
COPY --from=smart-cicd-builder /app/dist/services/rule-engine/ ./services/rule-engine/
COPY --from=smart-cicd-builder /app/package.json ./
COPY --from=smart-cicd-builder /app/node_modules ./node_modules
ENV NODE_ENV=production
CMD ["services/rule-engine/index.js"]
