# syntax=docker/dockerfile:1
# AI-supervisor service image (stub).
#
# Requires buildx with a pre-built builder image:
#   docker buildx build -t smart-cicd-builder:local . --push
#   docker buildx build \
#       --build-context smart-cicd-builder=docker-image://smart-cicd-builder:local \
#       -f services/ai-supervisor/Dockerfile.ai-supervisor \
#       -t ghcr.io/bolinz/smart-cicd/ai-supervisor:$TAG .
#
# Simpler local build (no buildx required):
#   docker build --target runtime-ai-supervisor -f Dockerfile -t smart-cicd/ai-supervisor:local .

FROM gcr.io/distroless/nodejs20-debian11 AS runtime
WORKDIR /app
COPY --from=smart-cicd-builder /app/dist/services/ai-supervisor/ ./services/ai-supervisor/
COPY --from=smart-cicd-builder /app/package.json ./
COPY --from=smart-cicd-builder /app/node_modules ./node_modules
ENV NODE_ENV=production
CMD ["services/ai-supervisor/index.js"]
